/*******************************************************************************************
  SIMPL+ Module Information
  (Fill in comments below)
*******************************************************************************************/
/*
Dealer Name: Control Concepts, Inc.
Programmer: MFS
Comments:
*/

/*******************************************************************************************
  Compiler Directives
  (Uncomment and declare compiler directives as needed)
*******************************************************************************************/

#SYMBOL_NAME "Lutron RadioRA 3 Fan Control v1.1.1"


#CATEGORY "0" 


#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#DIGITAL_EXPAND InputsWithParams

/*
#HELP_BEGIN
   (add additional lines of help lines)
#HELP_END
*/

/*******************************************************************************************
  Include Libraries
  (Uncomment and include additional libraries as needed)
*******************************************************************************************/
#USER_SIMPLSHARP_LIBRARY "Lutron.Leap.CommLib"

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
DIGITAL_INPUT _SKIP_,_SKIP_,_SKIP_,_SKIP_;
DIGITAL_INPUT FanSpeed_Off, FanSpeed_Low;
DIGITAL_INPUT FanSpeed_Medium, FanSpeed_MediumHigh;
DIGITAL_INPUT FanSpeed_High;

DIGITAL_OUTPUT _SKIP_,_SKIP_;
DIGITAL_OUTPUT Is_Initialized,_SKIP_;
DIGITAL_OUTPUT FanSpeed_Is_Off, FanSpeed_Is_Low;
DIGITAL_OUTPUT FanSpeed_Is_Medium, FanSpeed_Is_MediumHigh;
DIGITAL_OUTPUT FanSpeed_Is_High;

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/

INTEGER_PARAMETER Command_Processor_ID;
LONG_INTEGER_PARAMETER Zone_Href_ID;

/*******************************************************************************************
  Parameter Properties
  (Uncomment and declare parameter properties as needed)
*******************************************************************************************/
#BEGIN_PARAMETER_PROPERTIES Command_Processor_ID
   propValidUnits = unitDecimal;
   propDefaultUnit = unitDecimal;
   propBounds = 1d , 10d;
   propDefaultValue = 1d;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Zone_Href_ID
   propValidUnits = unitDecimal;
   propDefaultUnit = unitDecimal;
   propDefaultValue = 0d;
#END_PARAMETER_PROPERTIES
                
/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
FanComponent component;
                     
INTEGER Ready;
/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
EVENTHANDLER OnInitializationChange(FanComponent sender, InitializationEventArgs args)
{
	Is_Initialized = args.Payload;
	Ready = args.Payload;
}

EVENTHANDLER OnFanSpeedChange(FanComponent sender, FanSpeedEventArgs args)
{
	FanSpeed_Is_Off = (args.Payload = FanSpeedTypes.Off);
	FanSpeed_Is_Low = (args.Payload = FanSpeedTypes.Low);
	FanSpeed_Is_Medium = (args.Payload = FanSpeedTypes.Medium);
	FanSpeed_Is_MediumHigh = (args.Payload = FanSpeedTypes.MediumHigh);
	FanSpeed_Is_High = (args.Payload = FanSpeedTypes.High);
}
         
/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/
PUSH FanSpeed_Off
{
	IF (Ready)
		component.SetFanSpeed(FanSpeedTypes.Off);
}
 
PUSH FanSpeed_Low
{
	IF (Ready)
		component.SetFanSpeed(FanSpeedTypes.Low);
}

PUSH FanSpeed_Medium
{
	IF (Ready)
		component.SetFanSpeed(FanSpeedTypes.Medium);
}
 
PUSH FanSpeed_MediumHigh
{
	IF (Ready)
		component.SetFanSpeed(FanSpeedTypes.MediumHigh);
}

PUSH FanSpeed_High
{
	IF (Ready)
		component.SetFanSpeed(FanSpeedTypes.High);
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	WaitForInitializationComplete();
                                    	
	RegisterEvent(component, OnInitializationChange, OnInitializationChange);
	RegisterEvent(component, OnFanSpeedChange, OnFanSpeedChange);
	
	component.Configure(Command_Processor_ID, Zone_Href_ID);
}

