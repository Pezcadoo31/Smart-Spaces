/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
function log(string msg) 
{
  if(LOG_TO_FILE) GenerateUserNotice("%s", msg); 
  if(LOG_TO_CONSOLE) trace("%s", msg);
}

/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

PUSH enable
{
  if(Token = "")  
  {
    trace("The token is blank, cannot enable the module");
    return;
  }

  enabled = 1;
  Shades.Init(Token,LOG_TO_FILE,LOG_TO_CONSOLE);
}

RELEASE enable
{
  Shades.Disable();
  enabled = 0;
}

EVENTHANDLER OnUpdateList(ListEventArgs e) 
{
  string msg[256];

  makestring(msg, "update list -> type: %u  id: %s index: %u", e.Type, e.Id, e.Index);
  log(msg);

  switch(e.Type) 
  {
    case(1):  //OneWay
      OneWay[e.Index] = e.Id;
    case(2):  //TwoWay
      TwoWay[e.Index] = e.Id;
    case(3):  //Tilt
      Tilt[e.Index] = e.Id;
    case(4):    //TDBU
      TDBU[e.Index] = e.Id;
    default:
      trace("Unknown blind type, skipping");

  }
}

/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/
function Main()
{
  WaitForInitializationComplete();
  RegisterEvent(DooyaDevice, UpdateList, OnUpdateList);
}


