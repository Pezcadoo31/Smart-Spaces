/*******************************************************************************************
  Compiler Directives
  (Uncomment and declare compiler directives as needed)
*******************************************************************************************/

#SYMBOL_NAME "Lutron HomeWorks RadioRA 3 Lumaris RGB Zone Control v1.3"

           
#CATEGORY "0" 

#DEFINE_CONSTANT   TRUE   1
#DEFINE_CONSTANT   FALSE  0

#DEFAULT_VOLATILE
#ENABLE_STACK_CHECKING
#ENABLE_TRACE

#DIGITAL_EXPAND InputsWithParams

/*
#HELP_BEGIN
   (add additional lines of help lines)
#HELP_END
*/

/*******************************************************************************************
  Include Libraries
  (Uncomment and include additional libraries as needed)
*******************************************************************************************/
#USER_SIMPLSHARP_LIBRARY "Lutron.Leap.CommLib"

/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/

DIGITAL_INPUT _SKIP_, _SKIP_,_SKIP_; 
DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT Set_Dim_Level, Set_WhiteTuning_Level, Set_Hue_Saturation_Level, Set_Color_XY_Level;
DIGITAL_INPUT _SKIP_,WarmDim_ModifiedHalogen,WarmDim_Finire2700K,WarmDim_Finire3000K,WarmDim_GenericDaylight,WarmDim_Off;

ANALOG_INPUT _SKIP_, _SKIP_,_SKIP_,_SKIP_,_SKIP_,_SKIP_;
ANALOG_INPUT Dim_Level, FadeTime, WhiteTuning_Level, Hue_Level, Saturation_Level, Color_X_Level, Color_Y_Level; 

DIGITAL_OUTPUT _SKIP_, _SKIP_,_SKIP_;
DIGITAL_OUTPUT Is_Initialized;
DIGITAL_OUTPUT _SKIP_, _SKIP_; 
DIGITAL_OUTPUT _SKIP_,WarmDim_ModifiedHalogen_Fb,WarmDim_Finire2700K_Fb,WarmDim_Finire3000K_Fb,WarmDim_GenericDaylight_Fb, WarmDim_Off_Fb;
DIGITAL_OUTPUT _SKIP_,WarmDim_ModifiedHalogen_Supported,WarmDim_Finire2700K_Supported,WarmDim_Finire3000K_Supported,WarmDim_GenericDaylight_Supported;

ANALOG_OUTPUT _SKIP_; 
ANALOG_OUTPUT Dim_Level_Fb, FadeTime_Fb, WhiteTuning_Level_Fb, WhiteTuning_Range_Min_Fb, WhiteTuning_Range_Max_Fb, Hue_Level_Fb, Saturation_Level_Fb, Color_X_Level_Fb, Color_Y_Level_Fb;

/*******************************************************************************************
  Parameters
  (Uncomment and declare parameters as needed)
*******************************************************************************************/

INTEGER_PARAMETER Command_Processor_ID;
SIGNED_INTEGER_PARAMETER Fade_Time;
LONG_INTEGER_PARAMETER Zone_Href_ID;

/*******************************************************************************************
  Parameter Properties
  (Uncomment and declare parameter properties as needed)
*******************************************************************************************/

#BEGIN_PARAMETER_PROPERTIES Zone_Href_ID
   propValidUnits = unitDecimal;
   propDefaultUnit = unitDecimal;
   propDefaultValue = 0d;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Command_Processor_ID
   propValidUnits = unitDecimal;
   propDefaultUnit = unitDecimal;
   propBounds = 1d , 10d;
   propDefaultValue = 1d;
#END_PARAMETER_PROPERTIES

#BEGIN_PARAMETER_PROPERTIES Fade_Time
   propValidUnits = unitDecimal;
   propDefaultUnit = unitDecimal;
   propBounds = 0d , 14400d;
   propDefaultValue = 2d;
#END_PARAMETER_PROPERTIES


/*******************************************************************************************
  Global Variables
  (Uncomment and declare global variables as needed)
  Note:  Be sure to initialize all declared STRING variables as needed
         For example, in Function Main: myString = "";
*******************************************************************************************/
RGBComponent component;

INTEGER Saturation, Hue, ColorX, ColorY;

INTEGER Ready;  

/*******************************************************************************************
  Functions
  (Add any additional functions here)
  Note:  Functions must be physically placed before the location in
         the code that calls them.
*******************************************************************************************/
EVENTHANDLER OnInitializationChange(RGBComponent sender, InitializationEventArgs args)
{
	Is_Initialized = args.Payload;
	Ready = args.Payload;
}
          
EVENTHANDLER OnDimLevelChange(RGBComponent sender, DimLevelEventArgs args)
{
	Dim_Level_Fb = args.Payload;
}

EVENTHANDLER OnWhiteTuningLevelChange(RGBComponent sender, LevelEventArgs args)
{
	WhiteTuning_Level_Fb = args.Payload;
}


EVENTHANDLER OnWhiteTuningRangeChange(RGBComponent sender, WhiteTuningRangeEventArgs args)
{
   	WhiteTuning_Range_Min_Fb = args.Payload.Min;
	WhiteTuning_Range_Max_Fb = args.Payload.Max;

	WarmDim_ModifiedHalogen_Supported = component.IsCurveSupported(1);
	WarmDim_Finire2700K_Supported = component.IsCurveSupported(2);
	WarmDim_Finire3000K_Supported = component.IsCurveSupported(3);
	WarmDim_GenericDaylight_Supported = component.IsCurveSupported(4);
}
 

EVENTHANDLER OnWarmDimCurveChange(RGBComponent sender, CurveEventArgs args)
{
	WarmDim_ModifiedHalogen_Fb = FALSE;
	WarmDim_Finire2700K_Fb = FALSE;
	WarmDim_Finire3000K_Fb = FALSE;
	WarmDim_GenericDaylight_Fb = FALSE;
	WarmDim_Off_Fb = FALSE;

	SWITCH(args.Payload)
	{
  		CASE (1):
		{
			WarmDim_ModifiedHalogen_Fb = TRUE;
		}
       	CASE (2):
		{
			WarmDim_Finire2700K_Fb = TRUE;
		}
       	CASE (3):
		{
			WarmDim_Finire3000K_Fb = TRUE;
		}
       	CASE (4):
		{
			WarmDim_GenericDaylight_Fb = TRUE;
		}
		DEFAULT:
		{
			WarmDim_Off_Fb = TRUE;
		}
	}
}

EVENTHANDLER OnHueLevelChange(RGBComponent sender, LevelEventArgs args)
{
	Hue_Level_Fb = args.Payload;
	Hue = Hue_Level_Fb;
}

EVENTHANDLER OnSaturationLevelChange(RGBComponent sender, LevelEventArgs args)
{
	Saturation_Level_Fb = args.Payload;
	Saturation = Saturation_Level_Fb;
}

EVENTHANDLER OnColorXChange(RGBComponent sender, LevelEventArgs args)
{
	Color_X_Level_Fb = args.Payload;
	ColorX = Color_X_Level_Fb;
}

EVENTHANDLER OnColorYChange(RGBComponent sender, LevelEventArgs args)
{
	Color_Y_Level_Fb = args.Payload;
	ColorY = Color_Y_Level_Fb;
}

/*******************************************************************************************
  Event Handlers
  (Uncomment and declare additional event handlers as needed)
*******************************************************************************************/

RELEASE Set_Dim_Level
{
	IF (Ready && Dim_Level != Dim_Level_Fb)
	{
		component.SetDimLevel(Dim_Level);
	}
}

THREADSAFE CHANGE Dim_Level
{
 	IF (Ready && Set_Dim_Level)
	{
		component.SetDimLevel(Dim_Level);		
		DELAY(10);
	}
}

CHANGE FadeTime
{
	// Homeworks has a 4hr limit (Seconds)
	IF (Ready && FadeTime >=0 && FadeTime <= 14400)
	{
		component.FadeTime = FadeTime;

		FadeTime_Fb = component.FadeTime;
	}
}

RELEASE Set_WhiteTuning_Level
{
	IF (Ready && WhiteTuning_Level != WhiteTuning_Level_Fb)
	{
		component.SetWhiteTuningLevel(WhiteTuning_Level);
	}
}

THREADSAFE CHANGE WhiteTuning_Level
{
 	IF (Ready && Set_WhiteTuning_Level)
	{
		component.SetWhiteTuningLevel(WhiteTuning_Level);		
		DELAY(10);
	}
}    
    
RELEASE Set_Hue_Saturation_Level
{
	IF (Ready && Hue != Hue_Level_Fb || Saturation != Saturation_Level_Fb)
	{
		component.SetHueSaturationLevel(Hue, Saturation);
	}
}

THREADSAFE CHANGE Hue_Level
{
	Hue = Hue_Level;

 	IF (Ready && Set_Hue_Saturation_Level)
	{
		component.SetHueSaturationLevel(Hue, Saturation);		
		DELAY(10);
	}
}

THREADSAFE CHANGE Saturation_Level
{
	Saturation = Saturation_Level;

 	IF (Ready && Set_Hue_Saturation_Level)
	{
		component.SetHueSaturationLevel(Hue, Saturation);
		DELAY(10);
	}
}

RELEASE Set_Color_XY_Level
{
	IF (Ready && ColorX != Color_X_Level_Fb || ColorY != Color_Y_Level_Fb)
	{
		component.SetColorXYLevel(ColorX, ColorY);
	}
}

THREADSAFE CHANGE Color_X_Level
{
 	ColorX = Color_X_Level;

	IF (Ready && Set_Color_XY_Level)
	{
		component.SetColorXYLevel(ColorX, ColorY);		
		DELAY(10);
	}
}

THREADSAFE CHANGE Color_Y_Level
{
 	ColorY = Color_Y_Level;

	IF (Ready && Set_Color_XY_Level)
	{
		component.SetColorXYLevel(ColorX, ColorY);		
		DELAY(10);
	}
}



PUSH WarmDim_ModifiedHalogen
{
 	IF (Ready)
	{
		component.SetWarmDimCurve(1);		
	}
}

PUSH WarmDim_Finire2700K
{
 	IF (Ready)
	{
		component.SetWarmDimCurve(2);		
	}
}


PUSH WarmDim_Finire3000K
{
 	IF (Ready)
	{
		component.SetWarmDimCurve(3);		
	}
}

PUSH WarmDim_GenericDaylight
{
 	IF (Ready)
	{
		component.SetWarmDimCurve(4);		
	}
}

PUSH WarmDim_Off
{
 	IF (Ready)
	{
		component.SetWarmDimCurve(0);		
	}
}
      
/*******************************************************************************************
  Main()
  Uncomment and place one-time startup code here
  (This code will get called when the system starts up)
*******************************************************************************************/

Function Main()
{
	WaitForInitializationComplete();

	// VALUE WAS NOT SET!
	IF (component.FadeTime < 0)
		component.FadeTime = Fade_Time;

	FadeTime_Fb = component.FadeTime;
	
	RegisterEvent(component, OnInitializationChange, OnInitializationChange);
	RegisterEvent(component, OnDimLevelChange, OnDimLevelChange);
	RegisterEvent(component, OnWhiteTuningLevelChange, OnWhiteTuningLevelChange);
    RegisterEvent(component, OnWhiteTuningRangeChange, OnWhiteTuningRangeChange);
	RegisterEvent(component, OnHueLevelChange, OnHueLevelChange);
	RegisterEvent(component, OnSaturationLevelChange, OnSaturationLevelChange);
	RegisterEvent(component, OnColorXChange, OnColorXChange);
	RegisterEvent(component, OnColorYChange, OnColorYChange);


 	RegisterEvent(component, OnWarmDimCurveChange, OnWarmDimCurveChange);

	component.Configure(Command_Processor_ID, 7, Zone_Href_ID);
}

