#CATEGORY "46" "AirZone" // Custom

#USER_SIMPLSHARP_LIBRARY "AirZone"
#ENABLE_TRACE
#HELP_PDF_FILE "Airzone HVAC V1.0 Help file.pdf"

#DEFINE_CONSTANT MAX_ZONE_ERRORS	20
#DEFINE_CONSTANT MAX_ZONE_WARNINGS	20

DIGITAL_INPUT _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_;
DIGITAL_INPUT ManualPoll, _SKIP_;
DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT Setpoint_Up, Setpoint_Down;
DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT Power_On, Power_Off;
DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT Stages_Air_Set, Stages_Radiant_Set, Stages_Combined_Set;
DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT Modes_Stop_Set, Modes_Cooling_Set, Modes_Heating_Set, Modes_Fan_Set, Modes_Dry_Set, Modes_Auto_Set;
DIGITAL_INPUT _SKIP_;
DIGITAL_INPUT FanSpeeds_Auto_Set, FanSpeeds_1_Set, FanSpeeds_2_Set, FanSpeeds_3_Set, FanSpeeds_4_Set, FanSpeeds_5_Set, FanSpeeds_6_Set, FanSpeeds_7_Set;

ANALOG_INPUT _SKIP_;
ANALOG_INPUT Stages_Value_Set, Modes_Value_Set, FanSpeeds_Value_Set;

DIGITAL_OUTPUT _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_, _SKIP_;
DIGITAL_OUTPUT Initialized, _SKIP_, Polling;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT HasZoneErrors, HasZoneWarnings;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT Unit_Celsius_Active, Unit_Fahrenheit_Active;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT Humidity_Available;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT Setpoint_LowerLimit_Available, Setpoint_UpperLimit_Available;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT Powered_On, Powered_Off;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT Stages_Available, Stages_Controllable;
DIGITAL_OUTPUT _SKIP_;
DIGITAL_OUTPUT Stages_Air_Available, Stages_Radiant_Available, Stages_Combined_Available;
DIGITAL_OUTPUT _SKIP_;
DIGITAL_OUTPUT Stages_Air_Active, Stages_Radiant_Active, Stages_Combined_Active;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT Modes_Available, Modes_Controllable;
DIGITAL_OUTPUT _SKIP_;
DIGITAL_OUTPUT Modes_Stop_Available, Modes_Cooling_Available, Modes_Heating_Available, Modes_Fan_Available, Modes_Dry_Available, Modes_Auto_Available;
DIGITAL_OUTPUT _SKIP_;
DIGITAL_OUTPUT Modes_Stop_Active, Modes_Cooling_Active, Modes_Heating_Active, Modes_Fan_Active, Modes_Dry_Active, Modes_Auto_Active;

DIGITAL_OUTPUT _SKIP_, _SKIP_;
DIGITAL_OUTPUT Fanspeeds_Available, Fanspeeds_Controllable;
DIGITAL_OUTPUT _SKIP_;
DIGITAL_OUTPUT FanSpeeds_Auto_Available, FanSpeeds_1_Available, FanSpeeds_2_Available, FanSpeeds_3_Available, FanSpeeds_4_Available, FanSpeeds_5_Available, FanSpeeds_6_Available, FanSpeeds_7_Available;
DIGITAL_OUTPUT _SKIP_;
DIGITAL_OUTPUT FanSpeeds_Auto_Active, FanSpeeds_1_Active, FanSpeeds_2_Active, FanSpeeds_3_Active, FanSpeeds_4_Active, FanSpeeds_5_Active, FanSpeeds_6_Active, FanSpeeds_7_Active;

ANALOG_OUTPUT _SKIP_, _SKIP_;
ANALOG_OUTPUT Temperature_Analog, Humidity_Analog, Setpoint_Analog, SetpointLowerLimit_Analog, SetpointUpperLimit_Analog;
ANALOG_OUTPUT _SKIP_;
ANALOG_OUTPUT Stages_Active_Analog, Modes_Active_Analog, FanSpeeds_Active_Analog;
ANALOG_OUTPUT _SKIP_;
ANALOG_OUTPUT ZoneErrorsCount, ZoneWarningsCount;
STRING_OUTPUT _SKIP_;
STRING_OUTPUT Temperature, Humidity, Setpoint, SetpointLowerLimit, SetpointUpperLimit;
STRING_OUTPUT _SKIP_;
STRING_OUTPUT Stages_Active_Serial, Modes_Active_Serial, FanSpeeds_Active_Serial;
STRING_OUTPUT _SKIP_;
STRING_OUTPUT Name;

STRING_OUTPUT _SKIP_, _SKIP_;
STRING_OUTPUT ZoneErrors[MAX_ZONE_ERRORS];
STRING_OUTPUT _SKIP_;
STRING_OUTPUT ZoneWarnings[MAX_ZONE_WARNINGS];


INTEGER_PARAMETER SystemNumber;   
INTEGER_PARAMETER ZoneNumber;
INTEGER_PARAMETER AirStageControlEnabled; 
INTEGER_PARAMETER RadiantStageControlEnabled;
INTEGER_PARAMETER ModeControlEnabled;
INTEGER_PARAMETER FanSpeedControlEnabled; 

AirzoneZoneSimpl  myAirzoneZoneSimpl;

/*******************************************************************************************
  Global Variables
*******************************************************************************************/

/*******************************************************************************************
  Functions
*******************************************************************************************/

/*******************************************************************************************
  Signals
*******************************************************************************************/
PUSH ManualPoll
{
	myAirzoneZoneSimpl.ManualPoll();
}

PUSH Setpoint_Up
{
	myAirzoneZoneSimpl.SetpointUp(1);
}

RELEASE Setpoint_Up
{
	myAirzoneZoneSimpl.SetpointUp(0);
}

PUSH Setpoint_Down
{
	myAirzoneZoneSimpl.SetpointDown(1);
}

RELEASE Setpoint_Down
{
	myAirzoneZoneSimpl.SetpointDown(0);
}

PUSH Power_On
{
	myAirzoneZoneSimpl.PowerOn();
}

PUSH Power_Off
{
	myAirzoneZoneSimpl.PowerOff();
}


PUSH Stages_Air_Set
{
	myAirzoneZoneSimpl.SetStage(1);
}

PUSH Stages_Radiant_Set
{
	myAirzoneZoneSimpl.SetStage(2);
}

PUSH Stages_Combined_Set
{
	myAirzoneZoneSimpl.SetStage(3);
}

CHANGE Stages_Value_Set
{
	myAirzoneZoneSimpl.SetStage(Stages_Value_Set);
}

PUSH Modes_Stop_Set
{
	myAirzoneZoneSimpl.SetModus(1);
}

PUSH Modes_Cooling_Set
{
	myAirzoneZoneSimpl.SetModus(2);
}

PUSH Modes_Heating_Set
{
	myAirzoneZoneSimpl.SetModus(3);
}

PUSH Modes_Fan_Set
{
	myAirzoneZoneSimpl.SetModus(4);
}

PUSH Modes_Dry_Set
{
	myAirzoneZoneSimpl.SetModus(5);
}

PUSH Modes_Auto_Set
{
	myAirzoneZoneSimpl.SetModus(7);
}

CHANGE Modes_Value_Set
{
	myAirzoneZoneSimpl.SetModus(Modes_Value_Set);
}

PUSH FanSpeeds_Auto_Set
{
	myAirzoneZoneSimpl.SetFanspeed(0);
}

PUSH FanSpeeds_1_Set
{
	myAirzoneZoneSimpl.SetFanspeed(1);
}


PUSH FanSpeeds_2_Set
{
	myAirzoneZoneSimpl.SetFanspeed(2);
}


PUSH FanSpeeds_3_Set
{
	myAirzoneZoneSimpl.SetFanspeed(3);
}

PUSH FanSpeeds_4_Set
{
	myAirzoneZoneSimpl.SetFanspeed(4);
}

PUSH FanSpeeds_5_Set
{
	myAirzoneZoneSimpl.SetFanspeed(5);
}

PUSH FanSpeeds_6_Set
{
	myAirzoneZoneSimpl.SetFanspeed(6);
}


PUSH FanSpeeds_7_Set
{
	myAirzoneZoneSimpl.SetFanspeed(7);
}

CHANGE FanSpeeds_Value_Set
{
	myAirzoneZoneSimpl.SetFanspeed(FanSpeeds_Value_Set);
}


/*******************************************************************************************
  Event Handlers
*******************************************************************************************/

EventHandler OnInitializedChanged(AirzoneZoneSimpl sender, SimplUShortEventArgs e)
{
	Initialized = e.Value;
}

EventHandler OnPolling(AirzoneZoneSimpl sender, EventArgs e)
{
	Pulse(100, Polling);
}

EventHandler OnLoaded(AirzoneZoneSimpl sender, SimplZoneLoadedEventArgs e)
{
	Name = e.Name;
       
	Temperature = e.Temperature;
    Temperature_Analog = e.TemperatureAnalog;

	Humidity = e.Humidity;
	Humidity_Analog = e.HumidityAnalog;
	Humidity_Available = e.HumidityAvailable;

    Setpoint = e.Setpoint;
	Setpoint_Analog = e.SetpointAnalog;

    SetpointLowerLimit = e.SetpointLowerLimit;
	SetpointUpperLimit = e.SetpointUpperLimit;
	SetpointLowerLimit_Analog = e.SetpointLowerLimitAnalog; 
	SetpointUpperLimit_Analog = e.SetpointUpperLimitAnalog;
	Setpoint_LowerLimit_Available = e.SetpointLowerLimitAvailable;
	Setpoint_UpperLimit_Available = e.SetpointUpperLimitAvailable;
    
	if(e.PowerStatus = 1)
	{
		Powered_Off = 0;
		Powered_On = 1;	
	} else
	{
    	Powered_On = 0;
		Powered_Off = 1;
	}
	
	Stages_Available = e.StagesAvailable;
	Stages_Controllable = e.StageControllable;	

	Stages_Air_Available = e.StageAirAvailable;
	Stages_Radiant_Available = e.StageRadiantAvailable;
	Stages_Combined_Available = e.StageCombinedAvailable;

	Stages_Air_Active = e.StageAirActive;
	Stages_Radiant_Active = e.StageRadiantActive;
	Stages_Combined_Active = e.StageCombinedActive;
    
	Stages_Active_Analog = e.ActiveStageAnalog;
	Stages_Active_Serial = e.ActiveStageSerial;

	Modes_Available = e.ModesAvailable;
	Modes_Controllable = e.ModeControllable;
	
	Modes_Stop_Available = e.ModeStopAvailable;
	Modes_Cooling_Available = e.ModeCoolingAvailable;
	Modes_Heating_Available = e.ModeHeatingAvailable;
	Modes_Fan_Available = e.ModeFanAvailable;
	Modes_Dry_Available = e.ModeDryAvailable;
	Modes_Auto_Available = e.ModeAutoAvailable;
	
	Modes_Stop_Active = e.ModeStopActive;
	Modes_Cooling_Active = e.ModeCoolingActive;
	Modes_Heating_Active = e.ModeHeatingActive;
	Modes_Fan_Active = e.ModeFanActive;
	Modes_Dry_Active = e.ModeDryActive;
	Modes_Auto_Active = e.ModeAutoActive;
	
	Modes_Active_Analog = e.ActiveModeAnalog;
	Modes_Active_Serial = e.ActiveModeSerial;

	FanSpeeds_Available = e.SpeedsAvailable;
	FanSpeeds_Controllable = e.SpeedControllable;

	FanSpeeds_Auto_Available = e.SpeedAutoAvailable;
	FanSpeeds_1_Available = e.SpeedOneAvailable;
	FanSpeeds_2_Available = e.SpeedTwoAvailable;
	FanSpeeds_3_Available = e.SpeedThreeAvailable;
	FanSpeeds_4_Available = e.SpeedFourAvailable;
	FanSpeeds_5_Available = e.SpeedFiveAvailable;
	FanSpeeds_6_Available = e.SpeedSixAvailable;
	FanSpeeds_7_Available = e.SpeedSevenAvailable;	

	FanSpeeds_Auto_Active = e.SpeedAutoActive;
	FanSpeeds_1_Active = e.SpeedOneActive;
	FanSpeeds_2_Active = e.SpeedTwoActive;
	FanSpeeds_3_Active = e.SpeedThreeActive;
	FanSpeeds_4_Active = e.SpeedFourActive;
	FanSpeeds_5_Active = e.SpeedFiveActive;
	FanSpeeds_6_Active = e.SpeedSixActive;
	FanSpeeds_7_Active = e.SpeedSevenActive;

	FanSpeeds_Active_Analog = e.ActiveSpeedAnalog;
	FanSpeeds_Active_Serial = e.ActiveSpeedSerial;
}

EventHandler OnStatusChanged(AirzoneZoneSimpl sender, SimplZoneStatusEventArgs e)
{
	if(e.PowerStatus = 1)
	{
		Powered_Off = 0;
		Powered_On = 1;	
	} else
	{
    	Powered_On = 0;
		Powered_Off = 1;
	}

	Temperature = e.Temperature;
    Temperature_Analog = e.TemperatureAnalog;

	Humidity = e.Humidity;
	Humidity_Analog = e.HumidityAnalog;

	Stages_Air_Active = e.StageAirActive;
	Stages_Radiant_Active = e.StageRadiantActive;
	Stages_Combined_Active = e.StageCombinedActive;
    
	Stages_Active_Analog = e.ActiveStageAnalog;
	Stages_Active_Serial = e.ActiveStageSerial;

	Modes_Stop_Active = e.ModeStopActive;
	Modes_Cooling_Active = e.ModeCoolingActive;
	Modes_Heating_Active = e.ModeHeatingActive;
	Modes_Fan_Active = e.ModeFanActive;
	Modes_Dry_Active = e.ModeDryActive;
	Modes_Auto_Active = e.ModeAutoActive;
	
	Modes_Active_Analog = e.ActiveModeAnalog;
	Modes_Active_Serial = e.ActiveModeSerial;

	FanSpeeds_Auto_Active = e.SpeedAutoActive;
	FanSpeeds_1_Active = e.SpeedOneActive;
	FanSpeeds_2_Active = e.SpeedTwoActive;
	FanSpeeds_3_Active = e.SpeedThreeActive;
	FanSpeeds_4_Active = e.SpeedFourActive;
	FanSpeeds_5_Active = e.SpeedFiveActive;
	FanSpeeds_6_Active = e.SpeedSixActive;
	FanSpeeds_7_Active = e.SpeedSevenActive;

	FanSpeeds_Active_Analog = e.ActiveSpeedAnalog;
	FanSpeeds_Active_Serial = e.ActiveSpeedSerial;
}

EventHandler OnNameChanged(AirzoneZoneSimpl sender, SimplNameEventArgs e)
{
	Name = e.Name;
}

EventHandler OnSetpointStatusChanged(AirzoneZoneSimpl sender, SimplSetpointEventArgs e)
{
	Setpoint = e.Setpoint;
	Setpoint_Analog = e.SetpointAnalog;
}

EventHandler OnHumidityChanged(AirzoneZoneSimpl sender, SimplHumidityEventArgs e)
{
	Humidity = e.Humidity;
	Humidity_Analog = e.HumidityAnalog;
	Humidity_Available = e.HumidityAvailable;
}

EventHandler OnSetpointLimitsChanged(AirzoneZoneSimpl sender, SimplSetpointLimitEventArgs e)
{
	SetpointLowerLimit = e.SetpointLowerLimit;
	SetpointUpperLimit = e.SetpointUpperLimit;
	SetpointLowerLimit_Analog = e.SetpointLowerLimitAnalog; 
	SetpointUpperLimit_Analog = e.SetpointUpperLimitAnalog;
	Setpoint_LowerLimit_Available = e.SetpointLowerLimitAvailable;
	Setpoint_UpperLimit_Available = e.SetpointUpperLimitAvailable;
}

EventHandler OnModesChanged(AirzoneZoneSimpl sender, SimplModesEventArgs e)
{
    Modes_Available = e.ModesAvailable;
	Modes_Controllable = e.ModeControllable;
	
	Modes_Stop_Available = e.ModeStopAvailable;
	Modes_Cooling_Available = e.ModeCoolingAvailable;
	Modes_Heating_Available = e.ModeHeatingAvailable;
	Modes_Fan_Available = e.ModeFanAvailable;
	Modes_Dry_Available = e.ModeDryAvailable;
	Modes_Auto_Available = e.ModeAutoAvailable;
	
	Modes_Stop_Active = e.ModeStopActive;
	Modes_Cooling_Active = e.ModeCoolingActive;
	Modes_Heating_Active = e.ModeHeatingActive;
	Modes_Fan_Active = e.ModeFanActive;
	Modes_Dry_Active = e.ModeDryActive;
	Modes_Auto_Active = e.ModeAutoActive;
	
	Modes_Active_Analog = e.ActiveModeAnalog;
	Modes_Active_Serial = e.ActiveModeSerial;
}

EventHandler OnSpeedsChanged(AirzoneZoneSimpl sender, SimplSpeedsEventArgs e)
{
	FanSpeeds_Available = e.SpeedsAvailable;
	FanSpeeds_Controllable = e.SpeedControllable;

	FanSpeeds_Auto_Available = e.SpeedAutoAvailable;
	FanSpeeds_1_Available = e.SpeedOneAvailable;
	FanSpeeds_2_Available = e.SpeedTwoAvailable;
	FanSpeeds_3_Available = e.SpeedThreeAvailable;
	FanSpeeds_4_Available = e.SpeedFourAvailable;
	FanSpeeds_5_Available = e.SpeedFiveAvailable;
	FanSpeeds_6_Available = e.SpeedSixAvailable;
	FanSpeeds_7_Available = e.SpeedSevenAvailable;	

	FanSpeeds_Auto_Active = e.SpeedAutoActive;
	FanSpeeds_1_Active = e.SpeedOneActive;
	FanSpeeds_2_Active = e.SpeedTwoActive;
	FanSpeeds_3_Active = e.SpeedThreeActive;
	FanSpeeds_4_Active = e.SpeedFourActive;
	FanSpeeds_5_Active = e.SpeedFiveActive;
	FanSpeeds_6_Active = e.SpeedSixActive;
	FanSpeeds_7_Active = e.SpeedSevenActive;

	FanSpeeds_Active_Analog = e.ActiveSpeedAnalog;
	FanSpeeds_Active_Serial = e.ActiveSpeedSerial;
}

EventHandler OnStagesChanged(AirzoneZoneSimpl sender, SimplStagesEventArgs e)
{
	Stages_Available = e.StagesAvailable;
	Stages_Controllable = e.StageControllable;

	Stages_Air_Available = e.StageAirAvailable;
	Stages_Radiant_Available = e.StageRadiantAvailable;
	Stages_Combined_Available = e.StageCombinedAvailable;

	Stages_Air_Active = e.StageAirActive;
	Stages_Radiant_Active = e.StageRadiantActive;
	Stages_Combined_Active = e.StageCombinedActive;
    
	Stages_Active_Analog = e.ActiveStageAnalog;
	Stages_Active_Serial = e.ActiveStageSerial;
}

EventHandler OnUnitChanged(AirzoneZoneSimpl sender, SimplUnitEventArgs e)
{
	Unit_Celsius_Active = e.Celsius;
	Unit_Fahrenheit_Active = e.Fahrenheit;
}

EventHandler OnWarningsChanged(AirzoneZoneSimpl sender, SimplWarningsEventArgs e)
{
	integer i;

	for(i = 1 to e.Count)
	{
    	ZoneWarnings[i] = e.Messages[i - 1];
	}
	
	HasZoneWarnings = e.HasWarnings;
	ZoneWarningsCount = e.Count;	
}
 
EventHandler OnErrorsChanged(AirzoneZoneSimpl sender, SimplErrorsEventArgs e)
{
	integer i;

	for(i = 1 to e.Count)
	{
    	ZoneErrors[i] = e.Messages[i - 1];
	}
	
	HasZoneErrors = e.HasErrors;
	ZoneErrorsCount = e.Count;	 
}

EventHandler OnPowerStatusChanged(AirzoneZoneSimpl sender, SimplPowerStatusEventArgs e)
{
	if(e.PowerStatus = 1)
	{
		Powered_Off = 0;
		Powered_On = 1;	
	} else
	{
    	Powered_On = 0;
		Powered_Off = 1;
	}
}


EventHandler OnStageActiveChanged(AirzoneZoneSimpl sender, SimplStageActiveEventArgs e)
{
	Stages_Air_Active = e.StageAirActive;
	Stages_Radiant_Active = e.StageRadiantActive;
	Stages_Combined_Active = e.StageCombinedActive;
    
	Stages_Active_Analog = e.ActiveStageAnalog;
	Stages_Active_Serial = e.ActiveStageSerial;
}

EventHandler OnModeActiveChanged(AirzoneZoneSimpl sender, SimplModeActiveEventArgs e)
{
	Modes_Stop_Active = e.ModeStopActive;
	Modes_Cooling_Active = e.ModeCoolingActive;
	Modes_Heating_Active = e.ModeHeatingActive;
	Modes_Fan_Active = e.ModeFanActive;
	Modes_Dry_Active = e.ModeDryActive;
	Modes_Auto_Active = e.ModeAutoActive;
	
	Modes_Active_Analog = e.ActiveModeAnalog;
	Modes_Active_Serial = e.ActiveModeSerial;
}

EventHandler OnSpeedActiveChanged(AirzoneZoneSimpl sender, SimplSpeedActiveEventArgs e)
{
	FanSpeeds_Auto_Active = e.SpeedAutoActive;
	FanSpeeds_1_Active = e.SpeedOneActive;
	FanSpeeds_2_Active = e.SpeedTwoActive;
	FanSpeeds_3_Active = e.SpeedThreeActive;
	FanSpeeds_4_Active = e.SpeedFourActive;
	FanSpeeds_5_Active = e.SpeedFiveActive;
	FanSpeeds_6_Active = e.SpeedSixActive;
	FanSpeeds_7_Active = e.SpeedSevenActive;

	FanSpeeds_Active_Analog = e.ActiveSpeedAnalog;
	FanSpeeds_Active_Serial = e.ActiveSpeedSerial;
}

/*******************************************************************************************
  Main()
*******************************************************************************************/

Function Main()
{
	WaitforInitializationComplete();
    
	RegisterEvent(myAirzoneZoneSimpl, OnInitializedChanged, OnInitializedChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnPolling, OnPolling);
	RegisterEvent(myAirzoneZoneSimpl, OnLoaded, OnLoaded);
	RegisterEvent(myAirzoneZoneSimpl, OnStatusChanged, OnStatusChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnNameChanged, OnNameChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnHumidityChanged, OnHumidityChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnSetpointLimitsChanged, OnSetpointLimitsChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnModesChanged, OnModesChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnStagesChanged, OnStagesChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnSpeedsChanged, OnSpeedsChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnUnitChanged, OnUnitChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnErrorsChanged, OnErrorsChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnWarningsChanged, OnWarningsChanged);
	
	RegisterEvent(myAirzoneZoneSimpl, OnSetpointStatusChanged, OnSetpointStatusChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnPowerStatusChanged, OnPowerStatusChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnStageActiveChanged, OnStageActiveChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnModeActiveChanged, OnModeActiveChanged);
	RegisterEvent(myAirzoneZoneSimpl, OnSpeedActiveChanged, OnSpeedActiveChanged);

	myAirzoneZoneSimpl.Initialize(SystemNumber, ZoneNumber, AirStageControlEnabled, RadiantStageControlEnabled, ModeControlEnabled, FanSpeedControlEnabled);
}
