[BEGIN]
  ObjTp=Hd
  Cmn1=	CLA_Scrolling_Favs_v1.0.\\Descripción:	\\Modulo que muestra una||1
  Cmn2=o varias listas de favoritos organizados por categorías, por ejemplo||1
  Cmn3=los canales favoritos de un sistema de cable, y permite seleccionar||1
  Cmn4=algún canal de la lista, enviando el número del canal para, por||1
  Cmn5=ejemplo, enviarlo a un driver IR.\\Las listas se despliegan a través||1
  Cmn6=de líneas de texto, que pueden ser de 1 a 10. Las listas de favoritos||1
  Cmn7=se leen de un archivo. El archivo debe guardarse en la NVRAM del||1
  Cmn8=procesador, y la extensión del archivo puede ser .txt, .dat u otra,||1
  Cmn9=pero debe coincidir la cargada en el procesador con la declarada||1
  Cmn10=en el programa.\\La macro puede leer uno o varios archivos durante||1
  Cmn11=su ejecución en un programa. Actualmente el módulo contiene un límite||1
  Cmn12=de 50 categorías y 150 favoritos por archivo que lee.\\\\El formato||1
  Cmn13=del archivo  con las listas de categorías y favoritos debe ser el||1
  Cmn14=siguiente:\\____________________________________________\\//1	FAMILY	
  Cmn15=||	    Primero se escriben las categorías que se desean tener,\\
  Cmn16=//2	entertainment||  iniciando con doble diagonal"//", el número||1
  Cmn17=de la categoría, \\//3	music||	   después un tabulador(Tecla TAB)||1
  Cmn18=y al final el nombre, los caracteres "||" y enter.\\//4	sports	||\\
  Cmn19=FAVS 	       -> Después NECESARIAMENTE debe ir la palabara FAVS,||1
  Cmn20=que sirve de separador entre categorías y favoritos.\\//FOX	245	
  Cmn21=1||\\//ROD	313	1||	Finalmente se escriben los favoritos, iniciando||1
  Cmn22=con "//" el nombre, \\//WB	212	2||	 tecla Tabulador, el número del||1
  Cmn23=favorito, TABulador, y el \\//MTV	876	3||	número de la categoría||1
  Cmn24=correspondiente a la lista de   \\//HBO	123	4||	categorías de la||1
  Cmn25=primera sección, terminando con "||".\\//ESPN	638	4||\\----> 	Es||1
  Cmn26=necesario tener una línea en blanco al final.\\__________________________________
  Cmn27=_________\\	\\El nombre del archivo no puede rebasar los 30 caracteres,||1
  Cmn28=y simplemente debe ser el nombre del archivo y su extensión, p.e.
  Cmn29=:  favoritos.txt\\REVISIÓN HISTORICA:\\V 1.0:\\- Capacidad de leer||1
  Cmn30=archivos con cualquier extensión, y cambiar entre archivos durante||1
  Cmn31=la ejecución del mismo programa.\\- Número de líneas de salida ajustables||1
  Cmn32=de 1 a 10.\\- Información de actividad de lectura/escritura de archivos,||1
  Cmn33=para manejos de diversos módulos.\\\\V2.0 (Abril, 2009) \\-	Tendrá||1
  Cmn34=capacidad de modificar las listas de favoritos, pudiendo regrabar||1
  Cmn35=el archivo modificando los nombres de categorías, y el nombre, número||1
  Cmn36=y canal de cada favorito, así como poder agregar o quitar favoritos.
  Cmn37=\\-	Tendrá la capacidad de ordenar los favoritos en distintos órdenes,||1
  Cmn38=por ejemplo por letra o por número de canal.\\-	Soporte para navegación||1
  Cmn39=entre líneas (compatibilidad con A-PAD).\\-	Salto de página (actualmente||1
  Cmn40=solo se tiene salto por línea).\\\\Requerimientos de Hardware &||1
  Cmn41=Firmware:\\-	Procesador Crestron Serie-2.\\-	Mínimo firmware requerido:
  Cmn42=||14.000\\\\------------\\   INPUTS\\------------\\READ FILE	D	Con||1
  Cmn43=cada flanco de subida actualiza el archivo indicado por "NVRAM_File"\\
  Cmn44=CATEGORIES	D	Con cada flanco de subida muestra la lista de categorías||1
  Cmn45=almacenada en el archivo en el mismo orden en el que se encuentran||1
  Cmn46=en el archivo.\\CHANNELS	D	Con cada flanco de subida muestra la||1
  Cmn47=lista total de los favoritos contenidos en el archivo, en el mismo||1
  Cmn48=orden en que se encuentran, sin filtrar por categorías.\\\\NEXTLINE	
  Cmn49=D	Con cada flanco de subida cambia a la siguiente línea de la lista||1
  Cmn50=desplegada en ese momento.\\PREVLINE	D	Con cada flanco de subida||1
  Cmn51=cambia a la línea previa de la lista desplegada en ese momento\\
  Cmn52=FIRSTLINE	D	Con cada flanco de subida cambia a la primera línea||1
  Cmn53=de la lista desplegada en ese momento\\LASTLINE	D	Con cada flanco||1
  Cmn54=de subida cambia a la última línea de la lista desplegada en ese||1
  Cmn55=momento\\LINESEL[1-10]	D	Con cada flanco de subida selecciona la||1
  Cmn56=línea correspondiente  y realiza una de dos acciones:\\				- Si||1
  Cmn57=se está en la lista de categorías, se cambia a la lista de favoritos||1
  Cmn58=de la categoría seleccionada y muestra los favoritos correspondientes||1
  Cmn59=a la categoría seleccionada.\\				- Si se está en una lista de favoritos,||1
  Cmn60=se envían los datos del favorito seleccionado, número, nombre, categoría||1
  Cmn61=y después del tiempo determinado por "TimeBeforeEnter" se envía||1
  Cmn62=un pulso de enter de una duración determinada por "EnterLenght".
  Cmn63=\\El número de líneas se debe establecer manualmente agregando o||1
  Cmn64=quitando líneas (Con Alt+ y Alt -) y DEBE coincidir con el número||1
  Cmn65=de líneas que se declaren en las salidas (Line[1-10]).\\\\MainMenuName:
  Cmn66=||1Es el título que se mostrará en la línea Header cuando se pulse||1
  Cmn67="Categories". Tiene un límite de 20 caracteres.\\AllChannelsName:
  Cmn68=||1Es el título que se mostrará en la línea Header cuando se pulse||1
  Cmn69="Channels". Tiene un límite de 30 caracteres.\\NVRAM_File	$	Señal||1
  Cmn70=serial que debe contener el nombre del archivo que se va a leer||1
  Cmn71=de la NVRAM teniendo como formato el nombre del archivo y la extensión:
  Cmn72=||2favs.txt\\\\PARAMETROS:\\TimeBeforeEnter : El tiempo que esperara||1
  Cmn73=el modulo para enviar el enter, una vez que se seleccionó un favorito.
  Cmn74=||1\\EnterLenhgt: El tiempo que durará el pulso de enter.\\FileLocation:
  Cmn75=||1Determina la ubicación física del (o los) archivo(s ) que contienen||1
  Cmn76=la lista de favoritos, ya sea en la memoria interna NVRAM o en una||1
  Cmn77=tarjeta CompactFlash.\\\\\\-----------\\  OUTPUTS \\-----------\\
  Cmn78=Using_file	D	Se mantiene en alto todo el tiempo que el modulo mantenga||1
  Cmn79=abierto, lea o escriba en un archivo.\\Enter	D	El pulso de salida||1
  Cmn80=que se envía cuando se selecciona un favorito, determinado por los||1
  Cmn81=parámetros TimeBeforeEnter y EnterLenght.\\SelectedName$		$	El nombre||1
  Cmn82=del favorito seleccionado, determinado por el archivo.\\SelectionNumber	
  Cmn83=A	El número correspondiente al favorito seleccionado, determinado||1
  Cmn84=por el archivo.\\SelectedCategory	$	El nombre de la categoría del||1
  Cmn85=favorito seleccionado, de acuerdo al archivo.\\FavsFoundLines		A	
  Cmn86=El número de canales favoritos totales encontrados en el archivo.
  Cmn87=\\ListHeader	$	El encabezado que tendrá la lista. Es una línea aparte||1
  Cmn88=de las de navegación,  que indica en que lista se está navegando||1
  Cmn89=actualmente, ya sea en la lista de categorías, que tiene el nombre||1
  Cmn90=del parámetro MainMenuName, en la lista total de canales que toma||1
  Cmn91=el nombre del parámetro AllChannelsName o en alguna categoría, que||1
  Cmn92=toma el nombre de la categoría en la que se esta navegando.\\Line[1-
  Cmn93=10]	$	El texto de cada línea de la lista de navegación. 	 Para establecer||1
  Cmn94=el número de las líneas que se usarán simplemente hay que agregar||1
  Cmn95=o eliminar el número  deseado de líneas  (Con Alt+ y Alt-). Es necesario||1
  Cmn96=declarar el número exacto de líneas que se tendrá en la pantalla,||1
  Cmn97=ya que si se declaran líneas de más y se comentan ("//" ó  "//Line1")||1
  Cmn98=el módulo reconoce todas, y el funcionamiento no será el correcto.
  Cmn99=\\
[END]
