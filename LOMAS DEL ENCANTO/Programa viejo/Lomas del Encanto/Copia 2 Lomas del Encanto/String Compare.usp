/*******************************************************************************************
  DIGITAL, ANALOG and SERIAL INPUTS and OUTPUTS
  (Uncomment and declare inputs and outputs as needed)
*******************************************************************************************/
// DIGITAL_INPUT 
DIGITAL_INPUT UpdateString;
STRING_INPUT CurrentString$[50],CompareString$[10][50];
// BUFFER_INPUT 

DIGITAL_OUTPUT HighlightItem[10];
// ANALOG_OUTPUT 
// STRING_OUTPUT 


change UpdateString
{ 
	integer equal,x; 
	delay(10);
	for(x = 0 to 10)  
	{
 		equal = CompareStrings(CurrentString$,CompareString$[x]);
 		if(equal =0)
 			HighlightItem[x]=1;
 		else
			HighlightItem[x]=0;    	
 	}

}                         	

Function Main()
{
	WaitForInitializationComplete();
}
