Push Erase
{
	EraseFile();
}

Push Reload
{
	ReloadFile();
}
*/
//*******************************************************************************************/

Function Main()
{
    // TODO:  Add code here
    // Initialize declared global and local variables/arrays as needed.

    WaitForInitializationComplete();
    

	
	NumUsedLines=0;

   	FOR(NumUsedLines = 11 to 1 Step -1)
    {
    	IF(IsSignalDefined(Line[NumUsedLines]))
          Break;   	
	}
  

	t_bfore_enter=1*1;
	t_enter_lngt=1*1;

/*
	t_bfore_enter=TimeBeforeEnter*1;
	t_enter_lngt=EnterLenght*1;
*/
}
