/*******************************************************************************************
										  Global Variables
********************************************************************************************/

#DEFINE_CONSTANT MAXFAVS  	     150
#DEFINE_CONSTANT MAXCATS  	     50

STRING filename[30],sBuf[10000],cbuf[1000], cline[30], sLine[50],tempString[50];
STRING g_TempLine[100][30];//Temporaly Stores de Data for the Menu
integer Line1Index,NumUsedLines,CatsLines,FavsLines,FileLines,t_bfore_enter,t_enter_lngt,CategoryLineSel,ListType,DisplayedFavs,g_temp_lines,SubIndex[150];



/******STRUCTURES*******/
STRUCTURE ChannelStruct 	//-----------------STRUCT READ (Structure for the favorites)
{

STRING Canal[30];

INTEGER Number;

INTEGER Category;

};
ChannelStruct StructRead[MaxFavs];
                                


STRUCTURE CategoriesStruct	//-----------------CATEGORIES READ (Structure for the categories)
{

INTEGER Number;

STRING Nombre[30];	

};
CategoriesStruct CategoriesRead[MAXCATS];

/**********************************************************************************************************************
												  Functions
**********************************************************************************************************************/

Function MakeMenu()						// Sends the temporary list (g_TempLine) to the Lines.
{
	integer o;

	for(o=1 to NumUsedLines)
		{
			Line[o]=g_TempLine[o];
		}
}

Function EraseFile()
{
	integer x;
	signed_integer siFile;	
	string wrtLine[15];
		startfileoperations();

			siFile=fileopen(filename, _o_wronly);	//will overwrite 
			
			for(x=1 to FileLines)
			{
        		wrtLine= "Line : " + itoa(x)+ "\n";
				writestring(siFile, wrtLine);	//write line by line in the file
			}
         	fileclose(siFile);	//close the file, lamplog.txt
		endfileoperations();	

		clearbuffer (wrtLine);

}
Function ReloadFile()			//Writes de file with the data in Structure
{
	integer w,x,y,z;
	signed_integer siFile;	
	string wrtLine[50][15];
		startfileoperations();

			siFile=fileopen(filename, _o_wronly);	//will overwrite 
			
			for(x=0 to CatsLines)
			{
        		wrtLine[x]= itoa(CategoriesRead[x].Number) + "\x09" + CategoriesRead[x].Nombre;
			}
			x=x+1;
			wrtLine[x]="FAVS" + "\n";
			x=x+1;
			for(y=1 to FavsLines)
			{
        		wrtLine[x]= StructRead[y].Canal + "\x09" + itoa(StructRead[y].Number) + "\x09" + itoa(StructRead[x].Category) + "\n";
				x=x+1;
			}
			for(z=1 to x)
			{			
				writestring(siFile, wrtLine[z]);	//write one file line at a time, loc 1 to the last line
            }
         	fileclose(siFile);	//close the file, lamplog.txt
		endfileoperations();	

		for(w=1 to x)
		{
			clearbuffer (wrtLine[w]);
		}
}


/**********************************************************************************************************************
													EVENTS
***********************************************************************************************************************/

push readFile
{
	integer g,h,j;
	signed_integer nFileHandle,cBufferDone,bBufferDone,iChunkCount,lineCount,clineCount,Chnls_pos,i; //file handle
	string categories$[1000],tLine[50];


	//----------------------CLEARS THE PREVIOUS STRUCTURES-------------------
	for(g=1 to MAXCATS)				//Clears line by line the previous Categories structure
	{
			CategoriesRead[i].Number=0;
			CategoriesRead[i].Nombre="";    	
	}
	for(h=1 to MAXFAVS)
	{
			StructRead[i].Canal="";
			StructRead[i].Number=0;
			StructRead[i].Category=0;
	}
	for(j=1 to g_temp_lines)		//Clears the temporary list which is sent to screen.
	{
		g_TempLine[j]=" ";
	}
    
	if(FileLocation=0)
		filename="\\NVRAM\\"+NVRAM_File;	//makes the string for the file to be read.
	else if(FileLocation=1)
		filename="\\CF0\\"+NVRAM_File;

	startfileoperations();
	using_file=1;

		nFileHandle = fileopen(filename,_O_RDONLY);
		
    IF (nFileHandle >= 0) 

   {
    WHILE (FileRead(nFileHandle, sBuf, 10000) > 0) 	//Reads the file and copies it to sBuf
	{
      	bBufferDone = 0;
		cBufferDone=0;	      
	    
		categories$=remove("FAVS\n",sBuf);//Gets Categories Info from file
		Chnls_pos=find("FAVS",categories$);	//Removes FAVS word
		cbuf=left(categories$,Chnls_pos);
		clineCount=0;

//---------------------------------Makes Categories Structure-----------------------------
		  DO
		{
			cline = remove("||",cBuf);
			if (len(cLine) = 0)
			{
	  	    cBufferDone = 1;
			}
            else		//Do this after check if iteration has been done
			{
			clineCount=clineCount+1;
				if(find("//",cLine))
				{
					tLine = remove("//", cLine);
					CategoriesRead[clineCount].Number=atoi(Left(cLine,find("\x09", cLine)-1));
					tLine = remove("\x09", cLine);
					CategoriesRead[clineCount].Nombre=Left(cLine,find("||", cLine)-1);
					cline="";
				}
    		}
		}
		until (cBufferDone);

		clearbuffer(cline);
		clearbuffer(tLine);

		CatsLines=clineCount;        

		for (i=clinecount+1 to MAXCATS)	//Clears all the other inputs in Structure
		{
			CategoriesRead[i].Number=0;
			CategoriesRead[i].Nombre="";        	
		}
//---------------------------Ends Making Categories Structure------------------

		lineCount=0;

//---------------------------Makes Favs Structure------------------
		  DO
		{
			sLine = remove("||",sBuf);
			if (len(sLine) = 0)
			{
	  	    bBufferDone = 1;
			}
            //Do this after check if iteration has been done
			else
			{
				lineCount=lineCount+1;

				tLine = remove("//", sline);
				StructRead[lineCount].Canal=Left(sline,find("\x09", sline)-1);
                tLine = remove("\x09", sline);
				StructRead[lineCount].Number=atoi(Left(sline,find("\x09)", sline)-1));
				tLine = remove("\x09", sline);
				StructRead[lineCount].Category=atoi(Left(sline,find("||)", sline)-1));
				sline="";
			}
    	}
		until (bBufferDone);
				
		clearbuffer(sline);
		clearbuffer(tLine);

        FavsLines=lineCount;//------------------------Determines the number of Lines In the Favs
		FavsFoundLines=FavsLines;
		for (i=linecount+1 to MAXFAVS)	//Clears all the other inputs in Structure
		{
			StructRead[i].Canal="";
			StructRead[i].Number=0;
			StructRead[i].Category=0;         	
		}
//--------------------------------------------Ends Making Favs Structure-----------------------------------

		IF ( FileClose ( nFileHandle ) <> 0 ) 

        PRINT ( "Error closing file\n" );
		FileLines=CatsLines+1+FavsLines; 
	}
   } //end of if


	endfileoperations();
	using_file=0;

	clearbuffer(sBuf);
	clearbuffer(cbuf);

}


push Channels
{
    integer n;
	ListHeader[1]=AllChannelsName;
	for(n=1 to FavsLines)
	{												
		g_TempLine[n]=StructRead[n].Canal;
		SubIndex[n]=n;
    }
	g_temp_lines=FavsLines;
	DisplayedFavs= FavsLines;
	MakeMenu();  		//Sends Values to Screen Lines
	Line1Index=1;//Reinitialize the Index for the Line in Menu.
	ListType=2;//--------------List Type (1=Categories, 2= Channels)
}

push Categories
{
 	integer n,m;
    ListHeader[1]=MainMenuName;
	for(n=1 to CatsLines)
	{
		g_TempLine[n] = CategoriesRead[n].Nombre;
		SubIndex[n]=n;
	}
	if(CatsLines<NumUsedLines) 
	{
    	for(m=CatsLines+1 to NumUsedLines)
		{
			g_TempLine[m]="";
		}
	}
	g_temp_lines=CatsLines;
	MakeMenu();		//Sends Values to Screen Lines
	Line1Index=1;
	ListType=1;//--------------List Type (1=Categories, 2= Channels)
}

//-------------------------------------------NAVIGATION IN THE LIST BUTTONS-------------
Push NextLine
{
  	integer o,ind;
	o=1;
	ind=Line1Index;
	
    If(Line1Index<=g_temp_lines-NumUsedLines)
	{
		Line1Index=Line1Index+1;
		for(o=1 to NumUsedLines)
			{
				ind=ind+1;
				Line[o] = g_TempLine[ind];
			}
	}
}

Push PrevLine
{
  	integer o,ind;
	o=1;
	ind=Line1Index;
	
    If(Line1Index>1)
	{
		ind=ind-1;
		for(o=1 to NumUsedLines)
			{
			Line[o] = g_TempLine[ind];
			ind=ind+1;
//			SubIndex[o]=ind;
			}
	Line1Index=Line1Index-1;
	}
}

Push FirstLine
{
  	integer o,ind;
	o=1;
	
    If(Line1Index>1)
	{
		for(o=1 to NumUsedLines)
			{
			Line[o] = g_TempLine[o];
//			SubIndex[o]=o;			
			}
		Line1Index=1;
	}
}
Push LastLine
{
  	integer o,ind;
	o=1;
	
    If(Line1Index<=g_temp_lines-NumUsedLines)
	{
		Line1Index=g_temp_lines-NumUsedLines;
		ind=Line1Index;
		for(o=1 to NumUsedLines)
			{
				ind=ind+1;
				Line[o] = g_TempLine[ind];
			}
		Line1Index=g_temp_lines-NumUsedLines+1;
	}
}

//-------------------------------------Action for Selected Line---------------------------------------------
Push LineSel
{
 	integer n,l,i,cnt,CategorySel;
	CategoryLineSel=GetLastModifiedArrayIndex();
	n=1;
	cnt=0;
	l=1;
    
	CategorySel=Line1Index+CategoryLineSel-1;
	
	switch	(ListType)	//--------------List Type (1=Categories, 2= Channels)
	{
		case (1):	//---------------------------When shown list is categories.---------------------
		{
			//CategorySel=Line1Index+CategoryLineSel-1;
			if (CategorySel<=CatsLines)
			{
				Do{
					if (StructRead[n].Category=CategorySel)
					{
						g_TempLine[l] = StructRead[n].Canal;
						SubIndex[l]=n;
						cnt=cnt+1;
						l=l+1;
					}
					n=n+1;	
				   } 
				Until (n=FavsLines+1);
				Line1Index=1;	
				DisplayedFavs=cnt;
				g_temp_lines=DisplayedFavs;
				ListHeader[1]=CategoriesRead[CategorySel].Nombre;
				
				if(cnt< NumUsedLines+1)		//Clears all other lines.
				{
					for(i=cnt+1 to NumUsedLines)
						g_TempLine[i] = "";
				}
				MakeMenu();
			  	ListType=2;//----------------Now the list is Channels Type
			}
		}
		case (2):	//---------------------------When shown list is channels.---------------------
		{
			if (CategoryLineSel<=DisplayedFavs)
			{
				SelectedName$=StructRead[SubIndex[CategorySel]].Canal;
			    SelectionNumber=StructRead[SubIndex[CategorySel]].Number;
//				SelectedCategory=StructRead[SubIndex[CategorySel]].Category;
				SelectedCategory$=CategoriesRead[StructRead[SubIndex[CategorySel]].Category].Nombre;
				delay(t_bfore_enter);
				enter=1;
				delay(t_enter_lngt);
				enter=0;
			}
		}
	}
}
